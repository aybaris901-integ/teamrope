{
  "name": "teamrope",
  "displayName": "TeamRope",
  "description": "Git safety for beginner hackathon teams: Start task, Share changes, Sync and Team status, explained in plain English. Never pushes to main.",
  "version": "0.1.0",
  "publisher": "teamrope-dev",
  "license": "MIT",
  "icon": "media/icon.png",
  "homepage": "https://teamrope.site",
  "galleryBanner": {
    "color": "#134E4A",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aybaris901-integ/teamrope.git",
    "directory": "packages/vscode"
  },
  "homepage": "https://github.com/aybaris901-integ/teamrope#readme",
  "bugs": {
    "url": "https://github.com/aybaris901-integ/teamrope/issues"
  },
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "main": "./dist/extension.js",
  "extensionDependencies": [
    "vscode.git"
  ],
  "activationEvents": [
    "workspaceContains:.git",
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "teamrope",
          "title": "TeamRope",
          "icon": "media/icon-mono.svg"
        }
      ]
    },
    "views": {
      "teamrope": [
        {
          "id": "teamrope.you",
          "name": "You",
          "type": "webview",
          "initialSize": 3
        },
        {
          "id": "teamrope.team",
          "name": "Team",
          "visibility": "collapsed",
          "initialSize": 2
        },
        {
          "id": "teamrope.activity",
          "name": "Activity",
          "initialSize": 1
        }
      ]
    },
    "commands": [
      {
        "command": "teamrope.startTask",
        "title": "Start task",
        "category": "TeamRope",
        "icon": "$(add)"
      },
      {
        "command": "teamrope.save",
        "title": "Share changes",
        "category": "TeamRope",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "teamrope.sync",
        "title": "Sync",
        "category": "TeamRope",
        "icon": "$(sync)"
      },
      {
        "command": "teamrope.teamStatus",
        "title": "Team status",
        "category": "TeamRope",
        "icon": "$(organization)"
      },
      {
        "command": "teamrope.refresh",
        "title": "Refresh",
        "category": "TeamRope",
        "icon": "$(refresh)"
      },
      {
        "command": "teamrope.runNext",
        "title": "Do the next step",
        "category": "TeamRope"
      },
      {
        "command": "teamrope.showProblem",
        "title": "Show details",
        "category": "TeamRope"
      },
      {
        "command": "teamrope.copyMessage",
        "title": "Copy message",
        "category": "TeamRope",
        "icon": "$(copy)"
      },
      {
        "command": "teamrope.compare",
        "title": "Compare",
        "category": "TeamRope",
        "icon": "$(diff)"
      },
      {
        "command": "teamrope.setRole",
        "title": "Set my role",
        "category": "TeamRope"
      },
      {
        "command": "teamrope.openWalkthrough",
        "title": "Get started with TeamRope",
        "category": "TeamRope",
        "icon": "$(question)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "teamrope.openWalkthrough",
          "when": "view == teamrope.you",
          "group": "navigation@0"
        },
        {
          "command": "teamrope.refresh",
          "when": "view == teamrope.you || view == teamrope.team",
          "group": "navigation@1"
        },
        {
          "command": "teamrope.sync",
          "when": "view == teamrope.you || view == teamrope.team",
          "group": "1_actions@3"
        },
        {
          "command": "teamrope.startTask",
          "when": "view == teamrope.you || view == teamrope.team",
          "group": "1_actions@1"
        },
        {
          "command": "teamrope.save",
          "when": "view == teamrope.you || view == teamrope.team",
          "group": "1_actions@2"
        },
        {
          "command": "teamrope.teamStatus",
          "when": "view == teamrope.you || view == teamrope.team",
          "group": "1_actions@4"
        }
      ],
      "view/item/context": [
        {
          "command": "teamrope.compare",
          "when": "view == teamrope.team && viewItem =~ /comparable/",
          "group": "inline@1"
        },
        {
          "command": "teamrope.copyMessage",
          "when": "view == teamrope.team && viewItem =~ /copyable/",
          "group": "inline@2"
        }
      ],
      "commandPalette": [
        {
          "command": "teamrope.showProblem",
          "when": "false"
        },
        {
          "command": "teamrope.copyMessage",
          "when": "false"
        },
        {
          "command": "teamrope.compare",
          "when": "false"
        },
        {
          "command": "teamrope.setRole",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "TeamRope",
      "properties": {
        "teamrope.editorHints": {
          "type": "boolean",
          "default": true,
          "description": "Show who else is changing your code in the editor: file badges, a note above lines a teammate also changed, and lines that would conflict with main. The conflict notification still shows when this is off."
        },
        "teamrope.role": {
          "type": "string",
          "enum": [
            "captain",
            "member"
          ],
          "enumDescriptions": [
            "You keep an eye on the whole team: the Team view opens expanded.",
            "You focus on your own work: the Team view starts collapsed."
          ],
          "default": "member",
          "description": "Are you the team's captain or a team member?"
        }
      }
    },
    "walkthroughs": [
      {
        "id": "getStarted",
        "title": "Get started with TeamRope",
        "description": "Five small habits that keep your team's repo safe during a hackathon.",
        "steps": [
          {
            "id": "role",
            "title": "Are you the captain?",
            "description": "The captain keeps an eye on the whole team and helps when something goes wrong. Everyone else can focus on their own work. You can change this later in Settings.\n[I'm the captain](command:teamrope.setRole?%5B%22captain%22%5D)\n[I'm a team member](command:teamrope.setRole?%5B%22member%22%5D)",
            "media": {
              "svg": "media/walkthrough/role.svg",
              "altText": "A captain with a flag next to a team member"
            },
            "completionEvents": [
              "onSettingChanged:teamrope.role"
            ]
          },
          {
            "id": "repo",
            "title": "Open your team's repo",
            "description": "TeamRope works inside your team's Git repo. Open the folder you already have, or clone it from GitHub.\n[Open Folder](command:vscode.openFolder)\n[Clone Repository](command:git.clone)",
            "media": {
              "svg": "media/walkthrough/repo.svg",
              "altText": "A folder holding a Git repo"
            },
            "completionEvents": [
              "onContext:teamrope.hasRepo",
              "onCommand:vscode.openFolder",
              "onCommand:git.clone"
            ]
          },
          {
            "id": "startTask",
            "title": "Start a task",
            "description": "Every task gets its own branch, so nobody breaks anyone else's work. Start task makes the branch and uploads it for you.\n[Start task](command:teamrope.startTask)",
            "media": {
              "svg": "media/walkthrough/task.svg",
              "altText": "Your own branch leaving the shared main line"
            },
            "completionEvents": [
              "onCommand:teamrope.startTask"
            ]
          },
          {
            "id": "share",
            "title": "Share changes every 30–60 minutes",
            "description": "Sharing saves your work and uploads it to your own branch. Your team sees what you're doing, and nothing gets lost if your laptop dies.\n[Share changes](command:teamrope.save)",
            "media": {
              "svg": "media/walkthrough/share.svg",
              "altText": "A laptop uploading changes to the cloud"
            },
            "completionEvents": [
              "onCommand:teamrope.save"
            ]
          },
          {
            "id": "sync",
            "title": "An hour before the deadline: Sync",
            "description": "Sync brings the latest main into your branch, but only if it combines cleanly with your work. Doing it early means conflicts show up while there's still time to fix them.\n[Sync](command:teamrope.sync)",
            "media": {
              "svg": "media/walkthrough/sync.svg",
              "altText": "A clock before the deadline and two lines merging"
            },
            "completionEvents": [
              "onCommand:teamrope.sync"
            ]
          },
          {
            "id": "team",
            "title": "Watch Team",
            "description": "Team lists everyone else's problems: conflicts with main and two people changing the same code. Each problem says who should do what, and Copy message gives you a text to send.\n[Open Team](command:teamrope.teamStatus)",
            "media": {
              "svg": "media/walkthrough/team.svg",
              "altText": "A team list with one problem flagged"
            },
            "when": "config.teamrope.role == captain",
            "completionEvents": [
              "onCommand:teamrope.teamStatus"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "tsc --noEmit -p . && node esbuild.mjs",
    "package": "vsce package --no-dependencies --baseContentUrl https://github.com/aybaris901-integ/teamrope/blob/HEAD/packages/vscode --baseImagesUrl https://github.com/aybaris901-integ/teamrope/raw/HEAD/packages/vscode"
  },
  "dependencies": {
    "@teamrope/core": "0.0.0"
  },
  "devDependencies": {
    "@types/vscode": "1.90.0",
    "@vscode/codicons": "0.0.45",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2"
  },
  "keywords": [
    "git",
    "hackathon",
    "team",
    "merge conflicts",
    "beginners"
  ]
}
