{
  "name": "branchguard",
  "displayName": "branchguard",
  "description": "Keeps hackathon teams from breaking their Git repo: Start task, Save, Sync and Team status, explained in plain English.",
  "version": "0.0.1",
  "publisher": "branchguard-dev",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "main": "./dist/extension.js",
  "extensionDependencies": [
    "vscode.git"
  ],
  "activationEvents": [
    "workspaceContains:.git"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "branchguard",
          "title": "branchguard",
          "icon": "media/branchguard.svg"
        }
      ]
    },
    "views": {
      "branchguard": [
        {
          "id": "branchguard.you",
          "name": "You",
          "type": "webview"
        },
        {
          "id": "branchguard.team",
          "name": "Team"
        },
        {
          "id": "branchguard.activity",
          "name": "Activity"
        }
      ]
    },
    "commands": [
      {
        "command": "branchguard.startTask",
        "title": "Start task",
        "category": "branchguard",
        "icon": "$(add)"
      },
      {
        "command": "branchguard.save",
        "title": "Share changes",
        "category": "branchguard",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "branchguard.sync",
        "title": "Sync",
        "category": "branchguard",
        "icon": "$(sync)"
      },
      {
        "command": "branchguard.teamStatus",
        "title": "Team status",
        "category": "branchguard",
        "icon": "$(organization)"
      },
      {
        "command": "branchguard.refresh",
        "title": "Refresh",
        "category": "branchguard",
        "icon": "$(refresh)"
      },
      {
        "command": "branchguard.runNext",
        "title": "Do the next step",
        "category": "branchguard"
      },
      {
        "command": "branchguard.showProblem",
        "title": "Show details",
        "category": "branchguard"
      },
      {
        "command": "branchguard.copyMessage",
        "title": "Copy message",
        "category": "branchguard",
        "icon": "$(copy)"
      },
      {
        "command": "branchguard.compare",
        "title": "Compare",
        "category": "branchguard",
        "icon": "$(diff)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "branchguard.refresh",
          "when": "view == branchguard.you || view == branchguard.team",
          "group": "navigation@1"
        },
        {
          "command": "branchguard.sync",
          "when": "view == branchguard.you || view == branchguard.team",
          "group": "1_actions@3"
        },
        {
          "command": "branchguard.startTask",
          "when": "view == branchguard.you || view == branchguard.team",
          "group": "1_actions@1"
        },
        {
          "command": "branchguard.save",
          "when": "view == branchguard.you || view == branchguard.team",
          "group": "1_actions@2"
        },
        {
          "command": "branchguard.teamStatus",
          "when": "view == branchguard.you || view == branchguard.team",
          "group": "1_actions@4"
        }
      ],
      "view/item/context": [
        {
          "command": "branchguard.compare",
          "when": "view == branchguard.team && viewItem =~ /comparable/",
          "group": "inline@1"
        },
        {
          "command": "branchguard.copyMessage",
          "when": "view == branchguard.team && viewItem =~ /copyable/",
          "group": "inline@2"
        }
      ],
      "commandPalette": [
        {
          "command": "branchguard.showProblem",
          "when": "false"
        },
        {
          "command": "branchguard.copyMessage",
          "when": "false"
        },
        {
          "command": "branchguard.compare",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc --noEmit -p . && node esbuild.mjs",
    "package": "vsce package --no-dependencies --allow-missing-repository --skip-license"
  },
  "dependencies": {
    "@branchguard/core": "0.0.0"
  },
  "devDependencies": {
    "@types/vscode": "1.90.0",
    "@vscode/codicons": "0.0.45",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2"
  }
}
