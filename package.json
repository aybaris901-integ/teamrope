{
  "name": "branchguard-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/core",
    "packages/cli",
    "packages/vscode"
  ],
  "scripts": {
    "build": "tsc -b && npm run build -w branchguard",
    "test": "npm test --workspaces --if-present",
    "clean": "tsc -b --clean"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "typescript": "^5.7.0"
  }
}
